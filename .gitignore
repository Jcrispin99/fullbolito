# Per-tenant SQLite files (stancl/tenancy with sqlite driver — created mostly by tests)
/database/saas_base-*

# Per-tenant storage (stancl/tenancy FilesystemTenancyBootstrapper)
# Tenant IDs are dynamic (UUIDGenerator) and test/seed tenants use varying
# prefixes (test_*, wh_*, exp_*, orphan_*, etc.), so match the fixed
# subfolder structure inside any tenant instead of specific tenant names.
/storage/*/app/billing/certs/
/storage/*/app/billing/sales/
/storage/*/app/mpdf/
/storage/*/app/imports/
/storage/*/app/public/
